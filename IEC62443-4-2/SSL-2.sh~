#!/bin/bash
# 目標：重建 OpenSSL 連結並鎖死 TLS 1.2/1.3
CONF="/etc/ssl/openssl.cnf"

# 1. 備份原始檔案
sudo cp $CONF ${CONF}.backup_final

# 2. 清除檔案開頭可能導致失敗的重複 openssl_conf 定義
sudo sed -i '/openssl_conf = /d' $CONF

# 3. 在檔案的最頂端（第一行）注入關鍵連結
# 這是告訴 OpenSSL：請讀取底下的 [system_default_sect]
sudo sed -i '1i openssl_conf = default_conf' $CONF

# 4. 在檔案末尾追加完整的安全定義
sudo tee -a $CONF << EOT

[default_conf]
ssl_conf = ssl_sect

[ssl_sect]
system_default = system_default_sect

[system_default_sect]
MinProtocol = TLSv1.2
CipherString = DEFAULT@SECLEVEL=2
EOT

sudo sync
echo "OpenSSL Global Policy Enforced: [ OK ]"
