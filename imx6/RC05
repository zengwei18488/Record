./i2cset -f -y 1 0x52 0x0E 0x00   # 1. 切换扩展寄存器区，准备写入
./i2cset -f -y 1 0x52 0x0F 0x28   # 2. 锁定特定配置指针
./i2cset -f -y 1 0x52 0x37 0x1C   # 3. 关键：把充电使能(TCE=1)和限流电阻(TCR)数据写入 0x37 镜像 RAM
./i2cset -f -y 1 0x52 0x27 0x00   # 4. 清空 EEPROM 命令寄存器状态
./i2cset -f -y 1 0x52 0x27 0x11   # 5. 终极一击：写入 0x11 指令，强行触发芯片内部高压，将 0x37 的数据永远烧录进 EEPROM 物理单元
sleep 1                           # 6. 必须等待 1 秒，因为 EEPROM 的物理“热力学烧录”需要几个毫秒的稳定窗口


