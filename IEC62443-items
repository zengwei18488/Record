4、支持audit    CR2.08/CR2.09/CR2.10/CR3.09/CR6.01

cat <<EOF | sudo chroot $TARGET_ROOTFS_DIR
# 1. 定義變量
AUDIT_RULES="/etc/audit/rules.d/audit.rules"
AUDITD_CONF="/etc/audit/auditd.conf"
PLUGIN_CONF="/etc/audit/plugins.d/au-remote.conf"

# 2. 配置 Audit 規則 (CR 6.01, CR 2.08)
# 修正：RK3568 是 ARM64，必須使用 b64 或 aarch64
# 修正：去除了過於頻繁的讀寫監控，防止 eMMC 壽命縮短，專注於關鍵安全事件
cat <<EOT > \$AUDIT_RULES
## 刪除所有現有規則
-D

## 緩衝區大小 (工業環境建議提高)
-b 8192

## 監控執行行為 (CR 2.4 輔助)
-a always,exit -F arch=aarch64 -S execve -k exec_tracking

## 監控系統與審計配置變更 (CR 2.09)
-w /etc/systemd/ -p wa -k sys_config
-w /etc/audit/ -p wa -k audit_config
-w /etc/libaudit.conf -p wa -k audit_config
-w /var/log/audit/ -p wa -k audit_logs

## 監控帳號與權限變更 (CR 1.1, CR 1.2)
-w /etc/passwd -p wa -k identity
-w /etc/shadow -p wa -k identity
-w /etc/group -p wa -k identity
-w /etc/sudoers -p wa -k priv_esc
-w /etc/sudoers.d/ -p wa -k priv_esc

## 監控網路事件 (CR 7.1)
-a always,exit -F arch=aarch64 -S connect,accept,bind -F auid>=1000 -F auid!=4294967295 -k net_events

## 鎖定規則 (CR 6.01 - 規則不可在運行時修改)
-e 2
EOT

# 3. 配置審計日誌存儲策略 (CR 2.08)
# max_log_file = 100 代表 100MB
# space_left_action = SYSLOG 符合 CR 2.09 響應要求
sed -i "
  s|^max_log_file =.*|max_log_file = 100|;
  s|^num_logs =.*|num_logs = 10|;
  s|^space_left =.*|space_left = 50|;
  s|^admin_space_left =.*|admin_space_left = 15|;
  s|^admin_space_left_action =.*|admin_space_left_action = SYSLOG|;
  s|^disk_full_action =.*|disk_full_action = SYSLOG|;
  s|^disk_error_action =.*|disk_error_action = SYSLOG|;
" \$AUDITD_CONF

# 4. 配置插件與服務自動重啟 (CR 2.10, CR 2.08)
[ -f "\$PLUGIN_CONF" ] && sed -i "s/^active =.*/active = yes/" \$PLUGIN_CONF

# 修正：Debian 12 使用 systemd 管理服務，我們通過 override 實現服務自動重啟
mkdir -p /etc/systemd/system/auditd.service.d
cat <<UNIT > /etc/systemd/system/auditd.service.d/override.conf
[Service]
Restart=always
RestartSec=5s
UNIT

# 5. 權限加固 (CR 2.08)
chmod 640 \$AUDIT_RULES
chmod 640 \$AUDITD_CONF

EOF


